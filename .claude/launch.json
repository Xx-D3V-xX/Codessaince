{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "creditgate-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "src.api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "creditgate-frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5500",
        "--directory",
        "frontend",
        "--bind",
        "127.0.0.1"
      ],
      "port": 5500
    }
  ]
}
